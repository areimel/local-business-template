# Root .gitignore for the create-localbiz CLI package.
# NOTE: the site's own ignore rules now live in template/_gitignore (renamed so
# they survive `npm pack`; the CLI restores it to .gitignore on scaffold).
# Patterns below are intentionally non-anchored so they also match inside template/.

# dependencies
node_modules/

# build output / generated
dist/
.astro/
.netlify

# packed tarballs from `npm pack`
*.tgz

# environment variables
.env
.env.production

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS / editor
.DS_Store
.idea/

# Playwright / test output (inside template/)
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright-mcp/
coverage/
temp_images/

# Claude Code local settings
.claude/

# Git worktrees
.worktrees/
PUBLISHING_TODO.md
