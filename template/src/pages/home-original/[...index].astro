---
import PageLayout from '@/layouts/PageLayout.astro';
import HeroSection from '@/components/HomePageComponents/HeroSection.astro';
import ServicesOverview from '@/components/HomePageComponents/ServicesOverview.astro';
import WhyChooseUs from '@/components/HomePageComponents/WhyChooseUs.astro';
import TestimonialsSlider from '@/components/HomePageComponents/TestimonialsSlider.astro';
import HomeContactSection from '@/components/HomePageComponents/HomeContactSection.astro';
import { getBranding } from '@/utils/data';
import { gatedPaths } from '@/utils/features';

export async function getStaticPaths() {
  return gatedPaths('demoPages', () => [{ params: { index: undefined } }]);
}

const branding = getBranding();
---

<PageLayout title="Home" description={branding.seo.defaultDescription} showBreadcrumbs={false} noindex={true}>
  <HeroSection />
  <ServicesOverview />
  <WhyChooseUs />
  <TestimonialsSlider />
  <HomeContactSection />
</PageLayout>
