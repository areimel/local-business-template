---
import { getCollection, render } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import InnerHero from '@/components/InnerPageComponents/InnerHero.astro';
import SectionWrapper from '@/components/SharedComponents/SectionWrapper.astro';
import CtaBanner from '@/components/InnerPageComponents/CtaBanner.astro';
import { getBranding } from '@/utils/data';

// Markdown-driven static pages (privacy policy, accessibility, etc.).
// One route renders every entry in the `pages` collection — content lives in
// src/content/pages/*.md so non-developers (and Pages CMS) can edit prose.
export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, seoTitle, seoDescription, ogImage, noindex, heroHeading, lastUpdated, contactBlock, schemaData } =
  entry.data;
const { Content } = await render(entry);

const branding = getBranding();
const formattedDate = lastUpdated
  ? new Date(lastUpdated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
---

<PageLayout title={seoTitle ?? title} description={seoDescription} ogImage={ogImage} noindex={noindex} rawSchema={schemaData}>
  <InnerHero heading={heroHeading ?? title} />

  <SectionWrapper background="white">
    <div class="max-w-3xl mx-auto">
      <div class="space-y-6 text-text-muted leading-relaxed">
        {formattedDate && <p class="text-sm text-text-muted">Last updated: {formattedDate}</p>}

        <article class="prose-page space-y-6">
          <Content />
        </article>

        {contactBlock && (
          <section>
            <h2 class="text-xl font-heading font-bold text-text mb-3">Contact Information</h2>
            <p class="mb-3">If you have questions about this page, please contact us:</p>
            <ul class="space-y-1">
              <li>
                <strong class="text-text">Email:</strong>
                <a href={`mailto:${branding.email}`} class="text-primary hover:underline">{branding.email}</a>
              </li>
              <li>
                <strong class="text-text">Phone:</strong>
                <a href={`tel:${branding.phoneRaw}`} class="text-primary hover:underline">{branding.phone}</a>
              </li>
              <li><strong class="text-text">Address:</strong> {branding.address.full}</li>
            </ul>
          </section>
        )}
      </div>
    </div>
  </SectionWrapper>

  <CtaBanner />
</PageLayout>

<style>
  /* Markdown body styling — headings/lists rendered from .md, scoped to this route. */
  .prose-page :global(h2) {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-text);
    font-size: var(--text-xl);
    margin-bottom: 0.75rem;
  }
  .prose-page :global(h2:not(:first-child)) {
    margin-top: 2rem;
  }
  .prose-page :global(p) {
    margin-bottom: 0.75rem;
  }
  .prose-page :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-page :global(li) {
    margin-bottom: 0.25rem;
  }
  .prose-page :global(strong) {
    color: var(--color-text);
  }
  .prose-page :global(a) {
    color: var(--color-primary);
  }
  .prose-page :global(a:hover) {
    text-decoration: underline;
  }
</style>
