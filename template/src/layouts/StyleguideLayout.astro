---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/LayoutComponents/Header.astro';
import Footer from '../components/LayoutComponents/Footer.astro';

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title} noindex={true}>
  <Header />
  <div class="lg:grid lg:grid-cols-[260px_1fr]">
    <aside class="hidden lg:block sticky top-0 h-screen overflow-y-auto border-r border-neutral-200 bg-bg-alt p-6">
      <slot name="sidebar" />
    </aside>
    <div>
      <slot name="mobile-nav" />
      <main id="main-content" class="px-6 py-8 lg:px-12">
        <slot />
      </main>
    </div>
  </div>
  <Footer />
</BaseLayout>
