---
import { Image } from 'astro:assets';
import PrimaryButton from '@/components/ButtonComponents/PrimaryButton.astro';
import { getCtas } from '@/utils/data';
// Cloners: swap this for your own team/service photo.
import maintenancePhoto from '@/assets/images/team/staff-fistbump.jpg';

const { maintenancePlanCta } = getCtas();
---

{maintenancePlanCta && (
<section
  class="relative grid grid-cols-1 lg:grid-cols-[1.22fr_0.78fr] overflow-hidden isolate shadow-xl"
  style="background: linear-gradient(140deg, var(--color-primary-dark) 0%, color-mix(in srgb, var(--color-primary-dark) 60%, var(--color-primary)) 52%, var(--color-primary) 100%);"
  aria-labelledby="home-maintenance-plan-cta-heading"
>
  <!-- Content -->
  <div
    class="relative z-10 flex flex-col justify-center order-1
           px-5 sm:px-[clamp(1.25rem,5vw,5rem)] py-10 lg:py-[clamp(2.5rem,5vw,4.5rem)]"
    data-animate="fade-up"
  >
    <span class="inline-flex items-center gap-2 font-heading text-[0.95rem] font-extrabold tracking-widest uppercase text-accent-light">
      {maintenancePlanCta.eyebrow}
    </span>

    <h2
      id="home-maintenance-plan-cta-heading"
      class="mt-4 max-w-[12ch] font-heading text-[clamp(2rem,1.5rem+2vw,3rem)] font-extrabold leading-[0.96] text-white text-balance"
    >
      {maintenancePlanCta.heading}
    </h2>

    <p class="mt-5 max-w-[38rem] text-[clamp(1rem,0.94rem+0.3vw,1.2rem)] leading-relaxed text-white/85 text-balance">
      {maintenancePlanCta.body}
    </p>

    <div class="mt-7">
      <PrimaryButton
        text={maintenancePlanCta.buttonText}
        href={maintenancePlanCta.buttonUrl}
        icon="material-symbols:arrow-forward"
        size="lg"
      />
    </div>

    {maintenancePlanCta.disclaimer && (
      <p class="mt-4 max-w-[35rem] text-sm leading-relaxed text-white/70">
        {maintenancePlanCta.disclaimer}
      </p>
    )}
  </div>

  <!-- Photo -->
  <div class="relative z-10 order-2 min-h-[21rem] sm:min-h-[24rem] lg:min-h-0 overflow-hidden">
    <Image
      src={maintenancePhoto}
      alt=""
      widths={[768, 970]}
      sizes="(min-width: 1024px) 42vw, 100vw"
      class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
      loading="lazy"
      decoding="async"
    />
  </div>
</section>
)}
