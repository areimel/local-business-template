---
/**
 * HeroSlider.astro
 *
 * Full-viewport hero section with crossfading background image slider,
 * Ken Burns zoom effect, frosted glass form card, and animated CTAs.
 * Slider uses anime.js for crossfade sequencing with CSS fallback.
 */
import { getBranding, getCtas } from '@/utils/data';
import { isFeatureEnabled } from '@/utils/features';
import { Icon } from 'astro-icon/components';
import PrimaryButton from '@/components/ButtonComponents/PrimaryButton.astro';
import ButtonGroup from '@/components/ButtonComponents/ButtonGroup.astro';
import FormMessage from '@/components/FormComponents/FormMessage.astro';
import Checkbox from '@/components/FormComponents/Checkbox.astro';
import { Image } from 'astro:assets';

import heroImage from '@/assets/images/hero/tech-at-van.jpg';

const branding = getBranding();
const { hero } = getCtas();

const heroImageAlt = `${branding.companyName} technician in front of branded service van`;

const statPills = [
  ...(isFeatureEnabled('reviews') ? [{ icon: 'material-symbols:star', label: '4.9 Stars' }] : []),
  { icon: 'material-symbols:workspace-premium-outline', label: '35+ Years' },
  { icon: 'material-symbols:home-outline', label: '5,000+ Homes' },
  { icon: 'material-symbols:schedule-outline', label: '24/7 Service' },
];

const serviceOptions = [
  { value: '', label: 'Select a service' },
  { value: 'ac-repair', label: 'AC Repair & Service' },
  { value: 'ac-installation', label: 'AC Installation' },
  { value: 'ac-maintenance', label: 'AC Maintenance' },
  { value: 'heating', label: 'Heating Service' },
  { value: 'plumbing', label: 'Plumbing Service' },
  { value: 'electrical', label: 'Electrical Service' },
  { value: 'gas', label: 'Gas Service' },
  { value: 'insulation', label: 'Attic Insulation' },
  { value: 'duct-cleaning', label: 'Duct Cleaning' },
  { value: 'other', label: 'Other' },
];
---

<section
  class="hero-slider relative overflow-hidden flex items-center"
  aria-label="Hero"
>
  <!-- ===== Static Background Image ===== -->
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <Image
      src={heroImage}
      alt={heroImageAlt}
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      class="w-full h-full object-cover"
      loading="eager"
      decoding="sync"
    />
  </div>

  <!-- ===== Dark Gradient Overlay ===== -->
  <div
    class="absolute inset-0 z-[1] pointer-events-none"
    style="background: linear-gradient(135deg, rgba(0,15,40,0.82) 0%, rgba(0,30,70,0.65) 40%, rgba(0,20,50,0.55) 100%);"
    aria-hidden="true"
  ></div>

  <!-- ===== Decorative Noise Texture ===== -->
  <div
    class="absolute inset-0 z-[2] pointer-events-none mix-blend-soft-light"
    style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 256 256%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22n%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%224%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23n)%22 opacity=%220.04%22/%3E%3C/svg%3E'); background-size: 200px 200px;"
    aria-hidden="true"
  ></div>

  <!-- ===== Content Layer ===== -->
  <div class="section-container relative z-10 py-20 lg:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">

      <!-- Left Column: Hero Content (7 cols) -->
      <div class="lg:col-span-7">
        <!-- Stat pills -->
        <div class="flex flex-wrap gap-2 mb-6" data-animate="fade-up" data-on="load" data-distance="30" data-duration="600">
          {statPills.map((pill) => (
            <span class="glass-pill inline-flex items-center gap-1.5 rounded-full text-white text-xs sm:text-sm font-medium px-3.5 py-1.5">
              <Icon name={pill.icon} class="w-4 h-4 shrink-0 text-accent-light" aria-hidden="true" />
              {pill.label}
            </span>
          ))}
        </div>

        <!-- Heading -->
        <h1
          class="heading-hero text-white mb-5 max-w-2xl"
          data-animate="fade-up" data-on="load" data-delay="150"
        >
          {hero.heading}
        </h1>

        <!-- Subheading -->
        <p
          class="text-lg lg:text-xl text-white/90 mb-10 max-w-xl leading-relaxed"
          data-animate="fade-up" data-on="load" data-delay="300" data-distance="30" data-duration="600"
        >
          {hero.subheading}
        </p>

        <!-- CTA Buttons -->
        <div data-animate="fade-up" data-on="load" data-delay="450" data-distance="20" data-duration="500">
          <ButtonGroup stack="mobile">
            <PrimaryButton
              text={hero.primaryButton.text}
              href={hero.primaryButton.url}
              size="lg"
            />
            <a
              href={`tel:${branding.phoneRaw}`}
              class="btn btn-glass text-base px-6 py-3 lg:text-lg lg:px-8 lg:py-4 focus-visible:outline-white"
              aria-label={`Call us at ${branding.phone}`}
            >
              <Icon name="material-symbols:call-outline" class="w-5 h-5 shrink-0" aria-hidden="true" />
              Call {branding.phone}
            </a>
          </ButtonGroup>
        </div>
      </div>

      <!-- Right Column: Frosted Glass Form (5 cols) -->
      <div class="lg:col-span-5" data-animate="fade-up">
        <div class="glass-form rounded-(--radius-card) p-6 sm:p-8 shadow-xl">
          <h2 class="text-xl font-heading font-bold text-text mb-1">
            Get Your Free Estimate
          </h2>
          <p class="text-sm text-text-muted mb-5">
            Fill out the form and we'll get back to you within the hour.
          </p>

          <FormMessage id="hero-form-message" />

          <form
            id="hero-quick-form"
            action="/api/contact"
            method="POST"
            class="space-y-4"
          >
            <!-- Honeypot spam protection -->
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" aria-hidden="true" />

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="hero-name" class="form-label">Full Name</label>
                <input id="hero-name" name="name" type="text" required placeholder="John Smith" class="form-input" />
              </div>
              <div>
                <label for="hero-phone" class="form-label">Phone Number</label>
                <input id="hero-phone" name="phone" type="tel" required placeholder="(555) 555-0123" class="form-input" />
              </div>
            </div>

            <div>
              <label for="hero-service" class="form-label">Service Needed</label>
              <select id="hero-service" name="service" required class="form-input">
                {serviceOptions.map((opt) => (
                  <option value={opt.value} disabled={opt.value === ''} selected={opt.value === ''}>
                    {opt.label}
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label for="hero-date" class="form-label">Preferred Date</label>
              <input id="hero-date" name="preferred_date" type="date" class="form-input" />
            </div>

            <Checkbox name="consent" required size="sm">
              By submitting this form and signing up for texts, you consent to receive
              text messages from {branding.companyName} at the number provided, including
              messages sent by auto dialer. Consent is not a condition of purchase. Msg
              & data rates may apply. Msg frequency varies. Unsubscribe at any time
              by replying STOP. Reply HELP for help.
              <a href="/privacy-policy/" class="text-primary underline hover:text-primary-dark">Privacy Policy</a>.
            </Checkbox>

            <button
              type="submit"
              id="hero-form-submit-btn"
              class="btn btn-primary w-full"
            >
              <Icon name="material-symbols:calendar-month-outline" class="w-5 h-5 shrink-0" />
              <span>Request Estimate</span>
            </button>

            <p class="text-center text-xs text-text-muted mt-2">
              Or call us directly:
              <a
                href={`tel:${branding.phoneRaw}`}
                class="font-semibold text-primary hover:text-primary-dark"
              >
                {branding.phone}
              </a>
            </p>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ===== Hero Container ===== */
  .hero-slider {
    min-height: 100svh;
    min-height: 100vh; /* fallback */
  }

  /* ===== Glass Pills ===== */
  .glass-pill {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px) saturate(150%);
    -webkit-backdrop-filter: blur(8px) saturate(150%);
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  .glass-pill:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.3);
  }

</style>

<script>
  // ===== Form Handling =====
  function initHeroForm(): void {
    const form = document.getElementById('hero-quick-form') as HTMLFormElement;
    const submitBtn = document.getElementById('hero-form-submit-btn') as HTMLButtonElement;
    const messageContainer = document.getElementById('hero-form-message') as HTMLElement;
    const successMsg = document.getElementById('hero-form-message-success') as HTMLElement;
    const errorMsg = document.getElementById('hero-form-message-error') as HTMLElement;

    if (!form || !submitBtn) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      messageContainer?.classList.add('hidden');
      successMsg?.classList.add('hidden');
      errorMsg?.classList.add('hidden');

      const originalText = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <svg class="w-5 h-5 animate-spin" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25"></circle>
          <path fill="currentColor" class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        <span>Sending...</span>
      `;

      try {
        const formData = new FormData(form);
        const response = await fetch('/api/contact', {
          method: 'POST',
          body: formData,
        });

        const result = await response.json();

        if (response.ok && result.success) {
          messageContainer?.classList.remove('hidden');
          successMsg?.classList.remove('hidden');
          form.reset();
        } else {
          messageContainer?.classList.remove('hidden');
          errorMsg?.classList.remove('hidden');
        }
      } catch {
        messageContainer?.classList.remove('hidden');
        errorMsg?.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
      }
    });
  }

  // ===== Initialize =====
  initHeroForm();
</script>
