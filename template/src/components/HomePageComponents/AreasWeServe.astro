---
import SectionWrapper from '@/components/SharedComponents/SectionWrapper.astro';
import Badge from '@/components/SharedComponents/Badge.astro';
import ServiceAreaMap from '@/components/SharedComponents/ServiceAreaMap.astro';
import PrimaryButton from '@/components/ButtonComponents/PrimaryButton.astro';
import ButtonGroup from '@/components/ButtonComponents/ButtonGroup.astro';
import { Icon } from 'astro-icon/components';
import { getServiceAreas, getBranding } from '@/utils/data';

const serviceAreas = getServiceAreas();
const branding = getBranding();

const currentYear = new Date().getFullYear();
const yearsServing = currentYear - branding.yearEstablished;
---

<SectionWrapper id="areas-served" background="dark">
  <!-- Decorative top accent line -->
  <div class="absolute top-0 left-0 right-0 h-px" style="background: linear-gradient(to right, transparent, var(--color-primary), transparent);" aria-hidden="true"></div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">

    <!-- Map Visual (left on desktop, below heading on mobile) -->
    <div class="lg:col-span-7 relative order-2 lg:order-1" data-animate="fade-up">
      <div class="map-container relative mx-auto lg:mx-0 rounded-xl overflow-hidden border border-white/10" style="max-width: 520px;">

        <ServiceAreaMap
          aspectRatio="520/480"
          zoom={9}
          showRadiusBadge={false}
          showSinceBadge={true}
          variant="dark"
          ariaLabel={`Map of the ${branding.serviceArea.primary} service area`}
        />
      </div>
    </div>

    <!-- Content (right on desktop, first on mobile) -->
    <div class="lg:col-span-5 order-1 lg:order-2">
      <div data-animate="fade-up">
        <Badge text={serviceAreas.badge} variant="primary" size="md" />
        <h2 class="heading-display text-neutral-50 mt-4 mb-4">
          {serviceAreas.heading}
        </h2>
        <div class="flex items-center gap-2 mb-4" aria-hidden="true">
          <div class="w-8 h-px bg-primary/40"></div>
          <div class="w-1.5 h-1.5 rounded-full bg-primary"></div>
          <div class="w-8 h-px bg-primary/40"></div>
        </div>
        <p class="text-neutral-300 text-lg leading-relaxed mb-8">
          {serviceAreas.subheading}
        </p>
      </div>

      <!-- City pills -->
      <div class="flex flex-wrap gap-2 mb-10">
        {serviceAreas.cities.map((city) => (
          <span class="city-pill">
            {city}
          </span>
        ))}
      </div>

      <!-- Stats row -->
      <div class="flex items-center gap-6 mb-10 pb-8 border-b border-white/8" data-animate="fade-up">
        <div>
          <div class="text-2xl font-heading font-bold text-neutral-50">
            <span data-animate="counter" data-count-to={yearsServing}>0</span>+
          </div>
          <div class="text-xs text-neutral-400 mt-0.5">Years Serving</div>
        </div>
        <div class="w-px h-10 bg-white/10" aria-hidden="true"></div>
        <div>
          <div class="text-2xl font-heading font-bold text-neutral-50">
            <span data-animate="counter" data-count-to={serviceAreas.cities.length}>0</span>+
          </div>
          <div class="text-xs text-neutral-400 mt-0.5">Cities Covered</div>
        </div>
        <div class="w-px h-10 bg-white/10" aria-hidden="true"></div>
        <div>
          <div class="text-2xl font-heading font-bold text-neutral-50">{serviceAreas.coverageRadius}</div>
          <div class="text-xs text-neutral-400 mt-0.5">Mile Radius</div>
        </div>
      </div>

      <!-- CTA -->
      <div data-animate="fade-up">
        <ButtonGroup>
          <PrimaryButton
            text={serviceAreas.ctaText}
            href={serviceAreas.ctaUrl}
            icon="material-symbols:location-on-outline"
            size="lg"
          />
        </ButtonGroup>
      </div>
    </div>

  </div>
</SectionWrapper>

<style>
  /* City pill chip styling */
  .city-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-neutral-200);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.25s ease;
    cursor: default;
  }

  .city-pill:hover {
    background: rgba(var(--color-primary), 0.08);
    border-color: var(--color-primary);
    color: var(--color-primary-light);
    transform: translateY(-1px);
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .city-pill:hover {
      transform: none;
    }
  }
</style>
