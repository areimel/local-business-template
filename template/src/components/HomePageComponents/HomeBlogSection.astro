---
/**
 * HomeBlogSection.astro
 *
 * Displays the three most recent blog posts on the homepage,
 * pulling from the blog content collection. Only renders when
 * at least one non-draft post exists.
 */
import { getCollection } from 'astro:content';
import SectionWrapper from '@/components/SharedComponents/SectionWrapper.astro';
import Badge from '@/components/SharedComponents/Badge.astro';
import PrimaryButton from '@/components/ButtonComponents/PrimaryButton.astro';
import BlogPostCard from '@/components/BlogComponents/BlogPostCard.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
  .slice(0, 3);
---

{posts.length > 0 && (
  <SectionWrapper id="blog" background="white">
    <div class="mb-10 text-center" data-animate="fade-up">
      <Badge text="From the Blog" variant="primary" size="md" />
      <h2 class="heading-display mt-4 text-text">
        Tips &amp; Resources
      </h2>
      <p class="mt-3 mx-auto max-w-2xl text-lg leading-relaxed text-text-muted">
        Expert advice to help you keep your home comfortable year-round.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <BlogPostCard
          title={post.data.title}
          slug={post.data.slug}
          excerpt={post.data.excerpt}
          publishDate={post.data.publishDate}
          category={post.data.category}
          featuredImage={post.data.featuredImage}
          featuredImageAlt={post.data.featuredImageAlt}
          readingTime={post.data.readingTime}
          author={post.data.author}
        />
      ))}
    </div>

    <div class="mt-8 text-center" data-animate="fade-up">
      <PrimaryButton
        text="View All Posts"
        href="/blog/"
        icon="material-symbols:arrow-forward"
        size="md"
      />
    </div>
  </SectionWrapper>
)}
