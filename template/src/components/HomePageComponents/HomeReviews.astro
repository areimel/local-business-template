---
import { getBranding } from '@/utils/data';
import { getReviewsData, truncateReviewText } from '@/utils/reviews';
import { Icon } from 'astro-icon/components';
import SectionWrapper from '@/components/SharedComponents/SectionWrapper.astro';
import StarRating from '@/components/SharedComponents/StarRating.astro';
import { isFeatureEnabled } from '@/utils/features';

if (!isFeatureEnabled('reviews')) return;

const branding = getBranding();
const reviewsData = await getReviewsData();
const { reviews, overallRating, totalReviewCount, reviewUrl } = reviewsData;

// Deterministic avatar colors based on author name
const avatarColors = [
  '#9C27B0', // purple
  '#2196F3', // blue
  '#009688', // teal
  '#4CAF50', // green
  '#FF9800', // orange
  '#F44336', // red
  '#3F51B5', // indigo
  '#795548', // brown
];

function getAvatarColor(name: string): string {
  let hash = 0;
  for (let i = 0; i < name.length; i++) {
    hash = name.charCodeAt(i) + ((hash << 5) - hash);
  }
  return avatarColors[Math.abs(hash) % avatarColors.length];
}

function getInitial(name: string): string {
  return name.charAt(0).toUpperCase();
}
---

<SectionWrapper id="home-reviews" background="white">
  <!-- Section Header -->
  <div class="text-center max-w-4xl mx-auto mb-8 lg:mb-12" data-animate="fade-up">
    <h2 class="heading-display mb-4">
      What People Are Saying About
      <span class="text-primary"> {branding.companyName}</span>
    </h2>
    <p class="text-text-muted text-base lg:text-lg leading-relaxed max-w-3xl mx-auto">
      We're proud to be a trusted {branding.serviceArea.primary} company known for quality work and
      dependable service. With {totalReviewCount}+ five-star reviews, our team is recognized for
      skilled craftsmanship, clear communication, and exceptional results.
    </p>
  </div>

  <!-- Reviews Marquee -->
  <div class="reviews-marquee-container" data-animate="fade-up" role="list" aria-label="Customer reviews from Google">
    <div class="reviews-marquee-track">
      {[...reviews, ...reviews].map((review) => {
        const truncated = truncateReviewText(review.text, 200);
        const isTruncated = review.text.length > 200;
        return (
          <div
            class="reviews-marquee-item flex flex-col bg-white border border-neutral-200 rounded-(--radius-card) p-5 shadow-sm"
            role="listitem"
          >
            {/* Author Row */}
            <div class="flex items-start justify-between mb-3">
              <div class="flex items-center gap-3">
                {/* Avatar */}
                <div
                  class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-base shrink-0"
                  style={`background-color: ${getAvatarColor(review.authorName)}`}
                  aria-hidden="true"
                >
                  {getInitial(review.authorName)}
                </div>
                {/* Name & Date */}
                <div>
                  <p class="font-heading font-bold text-sm text-text leading-tight">{review.authorName}</p>
                  {review.relativeDate && (
                    <p class="text-text-muted text-xs mt-0.5">{review.relativeDate}</p>
                  )}
                </div>
              </div>
              {/* Google "G" Logo */}
              <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" aria-label="Google review" role="img">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>
            </div>

            {/* Star Rating + Verified */}
            <div class="flex items-center gap-1.5 mb-3">
              <StarRating rating={review.rating} size="sm" />
              <Icon name="material-symbols:verified-outline" class="w-4 h-4 text-info" aria-label="Verified review" />
            </div>

            {/* Review Text */}
            <p class="text-text text-sm leading-relaxed flex-1">
              {truncated}
            </p>

            {/* Read More Link */}
            {isTruncated && reviewUrl && (
              <a
                href={reviewUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-muted hover:text-primary text-sm mt-2 inline-block transition-colors"
              >
                Read more
              </a>
            )}
          </div>
        );
      })}
    </div>
  </div>

  {/* Overall Rating + CTA */}
  <div class="flex flex-wrap items-center justify-center gap-4 mt-8 lg:mt-10" data-animate="fade-up">
    <div class="flex items-center gap-2 text-sm text-text-muted">
      <StarRating rating={overallRating} size="sm" />
      <span class="font-bold text-text">{overallRating}</span>
      <span>out of 5 based on {totalReviewCount}+ Google reviews</span>
    </div>
    {reviewUrl && (
      <a
        href={reviewUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-outline text-sm"
        aria-label="See all reviews on Google"
      >
        See All Reviews
      </a>
    )}
  </div>
</SectionWrapper>

<style>
  .reviews-marquee-container {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 3%, black 97%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 3%, black 97%, transparent);
  }

  .reviews-marquee-track {
    display: flex;
    align-items: stretch;
    gap: 1.25rem;
    width: max-content;
    animation: reviews-marquee 50s linear infinite;
  }

  .reviews-marquee-item {
    flex-shrink: 0;
    width: 280px;
  }

  @media (min-width: 640px) {
    .reviews-marquee-item {
      width: 320px;
    }
  }

  @media (min-width: 1024px) {
    .reviews-marquee-item {
      width: 340px;
    }

    .reviews-marquee-track {
      gap: 1.5rem;
    }
  }

  @keyframes reviews-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .reviews-marquee-container:hover .reviews-marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews-marquee-track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }

    .reviews-marquee-container {
      mask-image: none;
      -webkit-mask-image: none;
    }
  }
</style>
