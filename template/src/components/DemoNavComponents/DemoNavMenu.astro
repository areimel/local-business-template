---
import { Icon } from 'astro-icon/components';
import type { DemoNavConfig } from '@/utils/demo-nav';

interface Props {
  config: DemoNavConfig;
}

const { config } = Astro.props;

// Normalize to the trailing-slash convention used in demo-nav.yaml, then compare
// with exact equality (not startsWith) so "/" only matches the homepage itself.
const currentPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const isActive = (url: string) => url === currentPath;
---

<div
  id="demo-nav-panel"
  class="fixed inset-0 z-50 hidden"
  role="dialog"
  aria-modal="true"
  aria-label={config.panelTitle}
>
  <!-- Overlay -->
  <div id="demo-nav-overlay" class="absolute inset-0 bg-black/50"></div>

  <!-- Drawer -->
  <div
    id="demo-nav-drawer"
    class="absolute left-0 top-0 h-full w-80 max-w-[85vw] bg-white shadow-xl overflow-y-auto transform -translate-x-full transition-transform duration-300"
  >
    <!-- Sticky Header -->
    <div class="sticky top-0 z-10 flex items-start justify-between gap-2 p-4 border-b border-neutral-200 bg-white">
      <div class="flex flex-col gap-0.5">
        <h2 class="text-base font-semibold text-neutral-900">{config.panelTitle}</h2>
        <p class="text-xs text-neutral-500">Internal preview routes — not part of the production nav.</p>
      </div>
      <button
        id="demo-nav-close"
        type="button"
        class="shrink-0 p-2 rounded-md text-neutral-500 hover:text-neutral-800 hover:bg-neutral-100 transition-colors"
        aria-label="Close demo navigation menu"
      >
        <Icon name="material-symbols:close" class="w-5 h-5" />
      </button>
    </div>

    <!-- Sections -->
    <nav class="p-4 space-y-6" aria-label="Demo and preview routes">
      {config.sections.map((section) => (
        <div>
          <h3 class="px-1 text-xs font-semibold uppercase tracking-wide text-neutral-400">{section.title}</h3>
          <ul class="mt-2 space-y-0.5">
            {section.links.map((link) => {
              const active = isActive(link.url);
              return (
                <li>
                  <a
                    href={link.url}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'block px-3 py-2 rounded-md text-sm transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2',
                      active
                        ? 'bg-primary/10 text-primary font-semibold'
                        : 'text-neutral-700 hover:text-primary hover:bg-neutral-100',
                    ]}
                  >
                    <span>{link.label}</span>
                    {link.description && (
                      <span class="block text-xs font-normal text-neutral-400">{link.description}</span>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</div>
