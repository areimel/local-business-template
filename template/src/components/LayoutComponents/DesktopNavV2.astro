---
import { getBranding } from '@/utils/data';
import { getVisibleNavigation } from '@/utils/features';
import FeatureFlag from '@/components/SharedComponents/FeatureFlag.astro';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import logoFull from '@/assets/logos/logo-full.svg';

const branding = getBranding();
const { mainNav } = getVisibleNavigation();
const currentPath = Astro.url.pathname;

const serviceCategories = mainNav.filter((item) => item.children);
const simpleLinks = mainNav.filter((item) => !item.children);

const MAX_ITEMS_PER_COLUMN = 5;

// Category metadata: icons + accent colors (matches ServicesOverview color language)
const categoryMeta: Record<string, { icon: string; accent: string; accentBg: string; accentText: string; accentBorder: string; hoverBg: string }> = {
  '/air-conditioning/': {
    icon: 'material-symbols:ac-unit',
    accent: 'bg-primary',
    accentBg: 'bg-primary/8',
    accentText: 'text-primary',
    accentBorder: 'border-primary/20',
    hoverBg: 'hover:bg-primary/5',
  },
  '/heating/': {
    icon: 'material-symbols:heat',
    accent: 'bg-accent',
    accentBg: 'bg-accent/8',
    accentText: 'text-accent-dark',
    accentBorder: 'border-accent/20',
    hoverBg: 'hover:bg-accent/5',
  },
  '/plumbing/': {
    icon: 'material-symbols:plumbing',
    accent: 'bg-secondary',
    accentBg: 'bg-secondary/8',
    accentText: 'text-secondary-dark',
    accentBorder: 'border-secondary/20',
    hoverBg: 'hover:bg-secondary/5',
  },
  '/electrical-services/': {
    icon: 'material-symbols:electric-bolt',
    accent: 'bg-info',
    accentBg: 'bg-info/8',
    accentText: 'text-info',
    accentBorder: 'border-info/20',
    hoverBg: 'hover:bg-info/5',
  },
  '/gas/': {
    icon: 'material-symbols:gas-meter',
    accent: 'bg-warning',
    accentBg: 'bg-warning/8',
    accentText: 'text-amber-700',
    accentBorder: 'border-warning/20',
    hoverBg: 'hover:bg-warning/5',
  },
};

const defaultMeta = {
  icon: 'material-symbols:home-repair-service',
  accent: 'bg-neutral-400',
  accentBg: 'bg-neutral-100',
  accentText: 'text-neutral-700',
  accentBorder: 'border-neutral-200',
  hoverBg: 'hover:bg-neutral-50',
};

const isServiceActive = serviceCategories.some(
  (cat) => currentPath.startsWith(cat.url)
);
---

<nav class="desktop-nav hidden lg:block relative z-40" aria-label="Main navigation">
  <!-- Nav bar -->
  <div class="nav-bar bg-white/95 backdrop-blur-md border-b border-neutral-100 shadow-sm">
    <div class="section-container">
      <div class="flex items-center justify-between h-[4.5rem]">

        <!-- Logo -->
        <a href="/" class="shrink-0 flex flex-col items-start gap-px group/logo" aria-label={`${branding.companyName} - Home`}>
          <Image
            src={logoFull}
            alt={branding.companyName}
            class="h-10 w-auto transition-transform duration-300 group-hover/logo:scale-[1.02]"
          />
          <span class="text-[0.625rem] font-semibold text-primary/80 tracking-[0.08em] uppercase leading-none" aria-hidden="true">
            Family Owned &amp; Operated
          </span>
        </a>

        <!-- Navigation Links -->
        <ul class="flex items-center gap-0.5" role="menubar">
          <!-- Services trigger -->
          <li class="relative" role="none" id="mega-menu-trigger">
            <button
              type="button"
              class:list={[
                'nav-link relative flex items-center gap-1 px-3.5 py-2 text-[0.8125rem] font-semibold tracking-tight rounded-lg transition-all duration-200 cursor-pointer',
                isServiceActive
                  ? 'text-primary'
                  : 'text-neutral-600 hover:text-neutral-900',
              ]}
              role="menuitem"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="mega-menu-panel"
            >
              Services
              <svg
                class="w-3.5 h-3.5 opacity-50 transition-transform duration-300"
                data-chevron
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
              {isServiceActive && <span class="nav-active-dot" />}
            </button>
          </li>

          {simpleLinks.map((item) => {
            const isActive = currentPath.startsWith(item.url) && item.url !== '/';
            return (
              <li role="none">
                <a
                  href={item.url}
                  class:list={[
                    'nav-link relative block px-3.5 py-2 text-[0.8125rem] font-semibold tracking-tight rounded-lg transition-all duration-200',
                    isActive
                      ? 'text-primary'
                      : 'text-neutral-600 hover:text-neutral-900',
                  ]}
                  role="menuitem"
                >
                  {item.label}
                  {isActive && <span class="nav-active-dot" />}
                </a>
              </li>
            );
          })}
        </ul>

        <!-- Actions -->
        <div class="flex items-center gap-2 shrink-0">
          <FeatureFlag name="search">
            <button
              type="button"
              data-search-trigger
              class="flex items-center justify-center w-9 h-9 rounded-lg text-neutral-500 hover:text-neutral-900 hover:bg-neutral-100 transition-colors duration-200 cursor-pointer"
              aria-label="Search this site"
            >
              <Icon name="material-symbols:search" class="w-5 h-5" />
            </button>
          </FeatureFlag>
          <a href="/contact/" class="btn btn-primary text-sm">
            Get an Estimate
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Backdrop overlay -->
  <div id="mega-menu-backdrop" class="fixed inset-0 top-0 bg-neutral-900/10 opacity-0 invisible transition-opacity duration-300 -z-10" aria-hidden="true" />

  <!-- Mega Menu -->
  <div
    id="mega-menu-panel"
    class="absolute left-0 right-0 top-full bg-white border-t border-neutral-100 opacity-0 invisible -translate-y-1 transition-all duration-300 ease-out z-50"
    style="box-shadow: 0 25px 60px -12px rgba(0,0,0,0.12), 0 8px 20px -8px rgba(0,0,0,0.06);"
    role="menu"
    aria-label="Services menu"
  >
    <div class="section-container py-7 pb-5">
      <!-- Category columns -->
      <div class="grid grid-cols-5 gap-5">
        {serviceCategories.map((category, colIndex) => {
          const meta = categoryMeta[category.url] || defaultMeta;
          const children = category.children || [];
          const visibleChildren = children.slice(0, MAX_ITEMS_PER_COLUMN);
          const hasMore = children.length > MAX_ITEMS_PER_COLUMN;
          const isCategoryActive = currentPath.startsWith(category.url);

          return (
            <div
              class="mega-col rounded-xl border border-transparent hover:border-neutral-100 hover:bg-neutral-50/50 p-3.5 -m-1 transition-all duration-200"
              style={`--col-index: ${colIndex};`}
            >
              {/* Category header */}
              <a
                href={category.url}
                class="flex items-center gap-2.5 mb-3 group/header"
              >
                <div class:list={[
                  'w-8 h-8 rounded-lg flex items-center justify-center shrink-0 transition-all duration-200 group-hover/header:scale-110',
                  meta.accentBg,
                ]}>
                  <Icon name={meta.icon} class:list={['w-[18px] h-[18px]', meta.accentText]} />
                </div>
                <span class:list={[
                  'text-[0.6875rem] font-bold font-heading uppercase tracking-[0.06em] transition-colors duration-200',
                  isCategoryActive
                    ? meta.accentText
                    : `text-neutral-700 group-hover/header:${meta.accentText.replace('text-', 'text-')}`,
                ]}>
                  {category.label}
                </span>
              </a>

              {/* Accent divider */}
              <div class="relative h-px mb-3">
                <div class="absolute inset-0 bg-neutral-100" />
                <div class:list={['absolute left-0 top-0 h-full w-8 rounded-full', meta.accent]} />
              </div>

              {/* Service items */}
              <ul class="space-y-px">
                {visibleChildren.map((child) => {
                  const isChildActive = currentPath === child.url;
                  return (
                    <li>
                      <a
                        href={child.url}
                        class:list={[
                          'group/link flex items-center gap-2 pl-2 pr-2 py-[0.4rem] text-[0.8125rem] leading-snug rounded-md transition-all duration-150',
                          isChildActive
                            ? `${meta.accentText} font-medium bg-neutral-50`
                            : `text-neutral-500 hover:text-neutral-800 ${meta.hoverBg}`,
                        ]}
                        role="menuitem"
                      >
                        <span class:list={[
                          'w-1 h-1 rounded-full shrink-0 transition-all duration-150',
                          isChildActive
                            ? meta.accent
                            : 'bg-neutral-300 group-hover/link:bg-neutral-400',
                        ]} />
                        {child.label}
                      </a>
                    </li>
                  );
                })}
              </ul>

              {/* "View All" link */}
              {hasMore && (
                <a
                  href={category.url}
                  class:list={[
                    'group/view inline-flex items-center gap-1 mt-2.5 pl-2 text-[0.6875rem] font-bold uppercase tracking-wide transition-colors duration-200',
                    meta.accentText,
                  ]}
                >
                  View All
                  <svg
                    class="w-3 h-3 transition-transform duration-200 group-hover/view:translate-x-0.5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              )}
            </div>
          );
        })}
      </div>

      {/* Bottom CTA strip */}
      <div class="mt-5 pt-4 border-t border-neutral-100 flex items-center justify-between">
        <div class="flex items-center gap-2 text-[0.8125rem] text-neutral-400">
          <Icon name="material-symbols:support-agent" class="w-4 h-4" />
          Not sure what you need? We'll help you figure it out.
        </div>
        <a
          href="/contact/"
          class="group/cta inline-flex items-center gap-2 text-[0.8125rem] font-bold text-primary hover:text-primary-dark transition-colors duration-200"
        >
          Schedule a Free Estimate
          <svg
            class="w-4 h-4 transition-transform duration-200 group-hover/cta:translate-x-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</nav>

<style>
  /* Active indicator dot beneath nav links */
  .nav-active-dot {
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background-color: var(--color-primary);
  }

  /* Staggered column reveal */
  .mega-col {
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 250ms ease-out, transform 250ms ease-out, background-color 200ms, border-color 200ms;
    transition-delay: calc(var(--col-index) * 50ms);
  }

  #mega-menu-panel.visible .mega-col {
    opacity: 1;
    transform: translateY(0);
  }

  /* Hover glow on nav links */
  .nav-link::before {
    content: '';
    position: absolute;
    inset: 2px;
    border-radius: 0.5rem;
    background: currentColor;
    opacity: 0;
    transition: opacity 200ms;
    pointer-events: none;
  }

  .nav-link:hover::before {
    opacity: 0.04;
  }

  @media (prefers-reduced-motion: reduce) {
    .mega-col {
      opacity: 1;
      transform: none;
      transition-delay: 0ms;
    }
    #mega-menu-panel {
      transition-duration: 0ms;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const trigger = document.getElementById('mega-menu-trigger');
    const panel = document.getElementById('mega-menu-panel');
    const backdrop = document.getElementById('mega-menu-backdrop');
    const button = trigger?.querySelector('button');
    const chevron = trigger?.querySelector('[data-chevron]');

    if (!trigger || !panel || !button) return;

    let closeTimeout: ReturnType<typeof setTimeout> | null = null;
    let openTimeout: ReturnType<typeof setTimeout> | null = null;
    const OPEN_DELAY = 80;
    const CLOSE_DELAY = 200;

    function open() {
      if (closeTimeout) { clearTimeout(closeTimeout); closeTimeout = null; }
      panel!.classList.remove('opacity-0', 'invisible', '-translate-y-1');
      panel!.classList.add('opacity-100', 'visible', 'translate-y-0');
      backdrop?.classList.remove('opacity-0', 'invisible');
      backdrop?.classList.add('opacity-100', 'visible');
      button!.setAttribute('aria-expanded', 'true');
      chevron?.classList.add('rotate-180');
    }

    function close() {
      if (openTimeout) { clearTimeout(openTimeout); openTimeout = null; }
      panel!.classList.remove('opacity-100', 'visible', 'translate-y-0');
      panel!.classList.add('opacity-0', 'invisible', '-translate-y-1');
      backdrop?.classList.remove('opacity-100', 'visible');
      backdrop?.classList.add('opacity-0', 'invisible');
      button!.setAttribute('aria-expanded', 'false');
      chevron?.classList.remove('rotate-180');
    }

    function scheduleOpen() {
      if (closeTimeout) { clearTimeout(closeTimeout); closeTimeout = null; }
      openTimeout = setTimeout(open, OPEN_DELAY);
    }

    function scheduleClose() {
      if (openTimeout) { clearTimeout(openTimeout); openTimeout = null; }
      closeTimeout = setTimeout(close, CLOSE_DELAY);
    }

    trigger.addEventListener('mouseenter', scheduleOpen);
    trigger.addEventListener('mouseleave', scheduleClose);

    panel.addEventListener('mouseenter', () => {
      if (closeTimeout) { clearTimeout(closeTimeout); closeTimeout = null; }
    });
    panel.addEventListener('mouseleave', scheduleClose);

    button.addEventListener('click', () => {
      const isOpen = button.getAttribute('aria-expanded') === 'true';
      if (isOpen) { close(); } else { open(); }
    });

    backdrop?.addEventListener('click', close);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button!.getAttribute('aria-expanded') === 'true') {
        close();
        button!.focus();
      }
    });

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!trigger.contains(target) && !panel.contains(target)) {
        close();
      }
    });
  });
</script>
