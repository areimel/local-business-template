---
import { getBranding, getNavigation } from '../../utils/data';
import { Image } from 'astro:assets';
import logoFull from '@/assets/logos/logo-full.svg';

const branding = getBranding();
const { mainNav } = getNavigation();
const currentPath = Astro.url.pathname;
---

<nav class="hidden lg:block bg-white shadow-sm" aria-label="Main navigation">
  <div class="w-full px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-24">
      <!-- Logo -->
      <a href="/" class="shrink-0 flex flex-col items-start gap-0.5" aria-label={`${branding.companyName} - Home`}>
        <Image src={logoFull} alt={branding.companyName} class="h-14 w-auto" />
        <span class="text-xs font-medium text-primary tracking-wide uppercase" aria-hidden="true">Family Owned &amp; Operated</span>
      </a>

      <!-- Navigation Links -->
      <ul class="flex items-center gap-1" role="menubar">
        {mainNav.map((item) => (
          <li class="relative group" role="none">
            <a
              href={item.url}
              class:list={[
                'flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-md transition-colors',
                currentPath.startsWith(item.url) && item.url !== '/'
                  ? 'text-primary bg-primary/5'
                  : 'text-neutral-700 hover:text-primary hover:bg-primary/5',
              ]}
              role="menuitem"
              aria-haspopup={item.children ? 'true' : undefined}
            >
              {item.label}
              {item.children && (
                <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>

            {/* Dropdown menu */}
            {item.children && (
              <ul
                class="absolute left-0 top-full mt-0 w-64 bg-white rounded-lg shadow-lg border border-neutral-200 py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50"
                role="menu"
              >
                {/* Link to the hub/parent page */}
                <li role="none">
                  <a
                    href={item.url}
                    class="block px-4 py-2 text-sm font-semibold text-primary hover:bg-primary/5 transition-colors border-b border-neutral-100 mb-1"
                    role="menuitem"
                  >
                    All {item.label} Services
                  </a>
                </li>
                {item.children.map((child) => (
                  <li role="none">
                    <a
                      href={child.url}
                      class:list={[
                        'block px-4 py-2 text-sm transition-colors',
                        currentPath === child.url
                          ? 'text-primary bg-primary/5 font-medium'
                          : 'text-neutral-700 hover:text-primary hover:bg-primary/5',
                      ]}
                      role="menuitem"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>

      <!-- CTA Button -->
      <a href="/contact/" class="btn btn-primary text-sm">
        Get an Estimate
      </a>
    </div>
  </div>
</nav>
