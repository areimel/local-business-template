---
import { getBranding } from '@/utils/data';

interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  tag?: string[];
}

interface Props {
  title?: string;
  titleOverride?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  ogType?: string;
  articleMeta?: ArticleMeta;
  noindex?: boolean;
}

const branding = getBranding();
const {
  title,
  titleOverride,
  description = branding.seo.defaultDescription,
  ogImage = branding.seo.defaultImage,
  canonicalUrl,
  ogType = 'website',
  articleMeta,
  noindex = false,
} = Astro.props;

// Build the page title — titleOverride bypasses the template entirely
const pageTitle = titleOverride
  ? titleOverride
  : title
    ? branding.seo.titleTemplate.replace('%s', title)
    : branding.seo.defaultTitle;

const resolvedOgImage = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, Astro.site).toString();

const resolvedCanonical = canonicalUrl || Astro.url.href;
---

<!-- Charset & Viewport -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Favicon -->
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon-192.png" />

<!-- Title & Description -->
<title>{pageTitle}</title>
<meta name="description" content={description} />

<!-- Canonical -->
<link rel="canonical" href={resolvedCanonical} />

{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Generator -->
<meta name="generator" content={Astro.generator} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:locale" content={branding.seo.locale} />
<meta property="og:site_name" content={branding.companyName} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />

<!-- Article Meta (blog posts) -->
{articleMeta && (
  <>
    {articleMeta.publishedTime && (
      <meta property="article:published_time" content={articleMeta.publishedTime} />
    )}
    {articleMeta.modifiedTime && (
      <meta property="article:modified_time" content={articleMeta.modifiedTime} />
    )}
    {articleMeta.section && (
      <meta property="article:section" content={articleMeta.section} />
    )}
    {articleMeta.tag && articleMeta.tag.map((t) => (
      <meta property="article:tag" content={t} />
    ))}
  </>
)}
