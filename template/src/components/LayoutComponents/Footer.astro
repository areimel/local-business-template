---
import { getBranding } from '../../utils/data';
import { getVisibleNavigation } from '@/utils/features';
import { Icon } from 'astro-icon/components';

const branding = getBranding();
const { mainNav } = getVisibleNavigation();

const currentYear = new Date().getFullYear();

const credit = branding.credit ?? {
  enabled: true,
  text: 'Website developed by Alec Reimel',
  url: 'https://alecreimel.com',
};

// Split nav items: services (with children) vs quick links (without)
const serviceLinks = mainNav.filter((item) => item.children);
const quickLinks = mainNav.filter((item) => !item.children);
---

<footer class="bg-neutral-900 text-neutral-300">
  <!-- Main Footer -->
  <div class="section-container py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Column 1: Company Info -->
      <div>
        <a href="/" aria-label={`${branding.companyName} - Home`}>
          <span class="text-2xl font-heading font-bold text-white block mb-4">
            {branding.companyNameShort}
          </span>
        </a>
        <p class="text-sm text-neutral-400 mb-4">
          {branding.tagline}
        </p>
        <address class="not-italic text-sm text-neutral-400 leading-relaxed">
          {branding.address.street}<br />
          {branding.address.suite && <>{branding.address.suite}<br /></>}
          {branding.address.city}, {branding.address.state} {branding.address.zip}
        </address>

        <!-- Social Links -->
        <div class="flex gap-3 mt-6">
          {branding.socialMedia.facebook && (
            <a
              href={branding.socialMedia.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center rounded-full bg-neutral-800 text-neutral-400 hover:bg-primary hover:text-white transition-colors"
              aria-label="Visit us on Facebook"
            >
              <Icon name="material-symbols:link" class="w-5 h-5" />
            </a>
          )}
          {branding.socialMedia.instagram && (
            <a
              href={branding.socialMedia.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 flex items-center justify-center rounded-full bg-neutral-800 text-neutral-400 hover:bg-primary hover:text-white transition-colors"
              aria-label="Visit us on Instagram"
            >
              <Icon name="material-symbols:photo-camera-outline" class="w-5 h-5" />
            </a>
          )}
        </div>
      </div>

      <!-- Column 2: Services -->
      <div>
        <h3 class="text-lg font-heading font-bold text-white mb-4">Our Services</h3>
        <ul class="space-y-2">
          {serviceLinks.map((item) => (
            <li>
              <a
                href={item.url}
                class="text-sm text-neutral-400 hover:text-accent-light transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Quick Links -->
      <div>
        <h3 class="text-lg font-heading font-bold text-white mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li>
            <a href="/" class="text-sm text-neutral-400 hover:text-accent-light transition-colors">
              Home
            </a>
          </li>
          {quickLinks.map((item) => (
            <li>
              <a
                href={item.url}
                class="text-sm text-neutral-400 hover:text-accent-light transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Contact -->
      <div>
        <h3 class="text-lg font-heading font-bold text-white mb-4">Contact Us</h3>
        <ul class="space-y-3">
          <li>
            <a
              href={`tel:${branding.phoneRaw}`}
              class="flex items-center gap-2 text-sm text-neutral-400 hover:text-accent-light transition-colors"
            >
              <Icon name="material-symbols:call" class="w-5 h-5 text-accent" />
              {branding.phone}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${branding.email}`}
              class="flex items-center gap-2 text-sm text-neutral-400 hover:text-accent-light transition-colors"
            >
              <Icon name="material-symbols:mail" class="w-5 h-5 text-accent" />
              {branding.email}
            </a>
          </li>
          <li>
            <a
              href={branding.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-2 text-sm text-neutral-400 hover:text-accent-light transition-colors"
            >
              <Icon name="material-symbols:location-on-outline" class="w-5 h-5 text-accent shrink-0 mt-0.5" />
              <span>{branding.address.full}</span>
            </a>
          </li>
        </ul>

        <!-- CTA Button -->
        <a href="/contact/" class="btn btn-primary mt-6 w-full text-sm">
          Get an Estimate
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-neutral-800">
    <div class="section-container py-4">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-neutral-500">
        <p>&copy; {currentYear} {branding.companyName}. All rights reserved.</p>
        <div class="flex gap-4">
          <a href="/privacy-policy/" class="hover:text-neutral-300 transition-colors">Privacy Policy</a>
          <a href="/accessibility-statement/" class="hover:text-neutral-300 transition-colors">Accessibility Statement</a>
          {credit.enabled !== false && (
            <a href={credit.url} class="hover:text-neutral-300 transition-colors" target="_blank" rel="noopener noreferrer">{credit.text}</a>
          )}
        </div>
        <p>Serving {branding.serviceArea.primary} &amp; surrounding areas.</p>
      </div>
    </div>
  </div>
</footer>
