---
import { Icon } from 'astro-icon/components';
import type { DemoToolsConfig } from '@/utils/demo-tools';
import { isFeatureEnabled } from '@/utils/features';
import ThemePicker from './tools/ThemePicker.astro';

interface Props {
  config: DemoToolsConfig;
}

const { config } = Astro.props;

// Normalize to the trailing-slash convention used in demo-tools.yaml, then compare
// with exact equality (not startsWith) so "/" only matches the homepage itself.
const currentPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const isActive = (url: string) => url === currentPath;

// The Tools tab is gated by devTools; with it off there is no tablist at all.
const showTools = isFeatureEnabled('devTools');
const tabs = [
  { id: 'pages', label: 'Pages' },
  ...(showTools ? [{ id: 'tools', label: 'Tools' }] : []),
];
---

<div
  id="demo-tools-panel"
  popover="auto"
  role="dialog"
  class="dmt dmt-panel"
  aria-label="Demo Mode Tools"
>
  <header class="dmt-head">
    <div class="dmt-head__text">
      <h2>{config.panelTitle}</h2>
      <p>Preview only — hidden when demoPages is off.</p>
    </div>
    <button
      type="button"
      class="dmt-close"
      popovertarget="demo-tools-panel"
      popovertargetaction="hide"
      aria-label="Close Demo Mode Tools"
    >
      <Icon name="material-symbols:close" class="dmt-icon" />
    </button>
  </header>

  {showTools && (
  <div class="dmt-tabs" role="tablist" aria-label="Demo Mode Tools sections">
    {tabs.map((t, i) => (
      <button
        type="button"
        role="tab"
        id={`dmt-tab-${t.id}`}
        data-tab={t.id}
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`dmt-tabpanel-${t.id}`}
        tabindex={i === 0 ? 0 : -1}
        class="dmt-tab"
      >{t.label}</button>
    ))}
  </div>
  )}

  <div class="dmt-body">
    <div
      id="dmt-tabpanel-pages"
      role={showTools ? 'tabpanel' : undefined}
      aria-labelledby={showTools ? 'dmt-tab-pages' : undefined}
    >
      <nav aria-label="Demo and preview pages">
        {config.sections.map((section) => (
          <details class="dmt-section" open={section.links.some((l) => isActive(l.url))}>
            <summary>
              <Icon name="material-symbols:chevron-right-rounded" class="dmt-chev" />
              <span class="dmt-section__title">{section.title}</span>
              <span class="dmt-count">{section.links.length}</span>
            </summary>
            <ul>
              {section.links.map((link) => {
                const active = isActive(link.url);
                return (
                  <li>
                    <a href={link.url} class="dmt-link" aria-current={active ? 'page' : undefined}>
                      <span class="dmt-link__label">{link.label}</span>
                      {link.description && <span class="dmt-link__desc">{link.description}</span>}
                    </a>
                  </li>
                );
              })}
            </ul>
          </details>
        ))}
      </nav>
    </div>

    {showTools && (
      <div id="dmt-tabpanel-tools" role="tabpanel" aria-labelledby="dmt-tab-tools" hidden>
        <div class="dmt-tools" data-dmt-tools>
          <!-- Tools: import each from ./tools/ and render here -->
          <ThemePicker />
        </div>
      </div>
    )}
  </div>
</div>

<style>
  .dmt-panel {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 0;
    left: 1rem;
    bottom: 8rem;
    width: min(22rem, calc(100vw - 2rem));
    max-height: min(36rem, calc(100vh - 9rem));
    max-height: min(36rem, calc(100dvh - 9rem));
    flex-direction: column;
    background: var(--dmt-graphite);
    border: 1px solid var(--dmt-rule);
    border-radius: var(--dmt-radius);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.4);
    overflow: hidden;
    opacity: 0;
    transform: translateY(6px) scale(0.98);
    transform-origin: bottom left;
    transition:
      opacity 140ms var(--dmt-ease),
      transform 140ms var(--dmt-ease),
      overlay 140ms allow-discrete,
      display 140ms allow-discrete;
  }
  @media (min-width: 1024px) {
    .dmt-panel { left: 1.5rem; }
  }
  .dmt-panel:popover-open {
    display: flex;
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .dmt-panel:popover-open {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
  }

  .dmt-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.875rem 0.75rem 0.5rem 1rem;
  }
  .dmt-head h2 { margin: 0; font-family: var(--dmt-font); font-size: 15px; font-weight: 600; line-height: 1.3; color: var(--dmt-paper); }
  .dmt-head p { margin: 2px 0 0; font-size: 12px; color: var(--dmt-fog); }
  .dmt-close {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--dmt-radius-sm);
    color: var(--dmt-fog);
    cursor: pointer;
  }
  .dmt-close:hover { background: var(--dmt-slate); color: var(--dmt-paper); }
  .dmt-icon { width: 1.125rem; height: 1.125rem; }

  .dmt-tabs {
    display: flex;
    gap: 2px;
    margin: 0.25rem 1rem 0.75rem;
    padding: 2px;
    background: var(--dmt-slate);
    border-radius: var(--dmt-radius-sm);
  }
  .dmt-tab {
    flex: 1;
    padding: 0.4rem 0.5rem;
    font-size: 13px;
    font-weight: 500;
    color: var(--dmt-fog);
    border-radius: 4px;
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }
  .dmt-tab:hover { color: var(--dmt-paper); }
  .dmt-tab[aria-selected='true'] {
    background: var(--dmt-slate-hi);
    color: var(--dmt-paper);
    border-bottom-color: var(--dmt-signal);
  }

  .dmt-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 1px solid var(--dmt-rule);
  }
  .dmt-body [hidden] { display: none; }

  .dmt-section + .dmt-section { border-top: 1px solid var(--dmt-rule); }
  .dmt-section summary {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 1rem;
    list-style: none;
    cursor: pointer;
    font-size: 13.5px;
    font-weight: 600;
  }
  .dmt-section summary::-webkit-details-marker { display: none; }
  .dmt-section summary:hover { background: var(--dmt-slate); }
  .dmt-section__title { flex: 1; }
  .dmt-section summary :global(.dmt-chev) {
    width: 1.125rem;
    height: 1.125rem;
    color: var(--dmt-fog);
    transition: transform 140ms var(--dmt-ease);
  }
  .dmt-section[open] summary :global(.dmt-chev) { transform: rotate(90deg); }
  .dmt-count {
    padding: 1px 7px;
    font-size: 11.5px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--dmt-fog);
    background: var(--dmt-slate);
    border-radius: var(--dmt-radius-sm);
  }
  .dmt-section ul { margin: 0; padding: 0 0.5rem 0.5rem; list-style: none; }

  .dmt-link {
    display: block;
    padding: 0.4rem 0.625rem 0.4rem 0.75rem;
    border-left: 3px solid transparent;
    border-radius: var(--dmt-radius-sm);
    color: var(--dmt-paper);
    font-size: 13.5px;
    text-decoration: none;
  }
  .dmt-link:hover { background: var(--dmt-slate); }
  .dmt-link[aria-current='page'] {
    border-left-color: var(--dmt-signal);
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    font-weight: 600;
  }
  .dmt-link__label, .dmt-link__desc { display: block; }
  .dmt-link__desc { font-size: 12px; font-weight: 400; color: var(--dmt-fog); }

  .dmt-tools { padding: 0; }
</style>
