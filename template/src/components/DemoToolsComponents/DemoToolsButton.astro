---
import { Icon } from 'astro-icon/components';

interface Props {
  label: string;
  ariaLabel: string;
}

const { label, ariaLabel } = Astro.props;
---

<button
  id="demo-tools-toggle"
  type="button"
  aria-expanded="false"
  aria-controls="demo-tools-panel"
  aria-label={ariaLabel}
  class="fixed bottom-[4.5rem] left-4 lg:left-6 z-50 flex items-center gap-2 rounded-(--radius-full) bg-neutral-900 px-4 py-2.5 text-sm font-medium text-white shadow-lg transition-colors hover:bg-neutral-800 active:bg-neutral-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
>
  <Icon name="material-symbols:space-dashboard-outline" class="w-5 h-5 shrink-0" />
  <span>{label}</span>
</button>
