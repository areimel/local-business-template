---
import { Icon } from 'astro-icon/components';
import type { Coupon } from '@/utils/data';

interface Props {
  coupon: Coupon;
}

const { coupon } = Astro.props;

const isFeatured = coupon.featured;

// Format the discount display
function getDiscountBadge(coupon: Coupon): string {
  switch (coupon.discountType) {
    case 'fixed':
      return `$${coupon.discountValue}`;
    case 'percentage':
      return `${coupon.discountValue}% Off`;
    case 'free':
      return 'FREE';
    default:
      return '';
  }
}

const discountBadge = getDiscountBadge(coupon);

// Format the expiry date
function formatDate(dateStr: string): string {
  if (!dateStr) return '';
  const date = new Date(dateStr + 'T00:00:00');
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}

const formattedDate = coupon.validUntil ? formatDate(coupon.validUntil) : '';

const borderColor = isFeatured ? 'border-primary' : 'border-neutral-300';
const badgeBg = isFeatured ? 'bg-primary text-white' : 'bg-neutral-700 text-white';
---

<div
  class:list={[
    'relative rounded-(--radius-card) border-2 border-dashed p-6 sm:p-8 bg-bg transition-shadow duration-300 hover:shadow-lg',
    borderColor,
  ]}
>
  {/* Featured badge */}
  {isFeatured && (
    <div class="absolute -top-3 left-6">
      <span class="inline-flex items-center gap-1.5 bg-secondary text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-sm">
        <Icon name="material-symbols:star" class="w-3.5 h-3.5" aria-hidden="true" />
        Featured
      </span>
    </div>
  )}

  {/* Discount badge */}
  <div class="flex items-start justify-between gap-4 mb-4 mt-1">
    <h3 class="text-xl font-heading font-bold text-text leading-tight">
      {coupon.title}
    </h3>
    {discountBadge && (
      <span
        class:list={[
          'shrink-0 inline-flex items-center justify-center rounded-full font-heading font-extrabold text-sm px-4 py-2',
          badgeBg,
        ]}
      >
        {discountBadge}
      </span>
    )}
  </div>

  {/* Description */}
  <p class="text-text-muted leading-relaxed mb-5">
    {coupon.description}
  </p>

  {/* Promo code */}
  {coupon.code && (
    <div class="mb-5">
      <p class="text-xs font-medium text-text-muted uppercase tracking-wider mb-1.5">Promo Code</p>
      <div class="inline-flex items-center gap-2 bg-bg-alt border border-neutral-200 rounded-(--radius-md) px-4 py-2">
        <Icon name="material-symbols:confirmation-number-outline" class="w-5 h-5 text-primary shrink-0" aria-hidden="true" />
        <code class="font-mono font-bold text-primary text-lg tracking-wider select-all">
          {coupon.code}
        </code>
      </div>
    </div>
  )}

  {/* Valid through */}
  {formattedDate && (
    <div class="flex items-center gap-2 text-sm text-text-muted mb-4">
      <Icon name="material-symbols:event-outline" class="w-4 h-4 shrink-0" aria-hidden="true" />
      <span>Valid through {formattedDate}</span>
    </div>
  )}

  {/* Terms / fine print */}
  {coupon.terms && (
    <div class="pt-4 border-t border-neutral-200">
      <p class="text-xs text-text-muted leading-relaxed">
        <span class="font-semibold">Terms:</span> {coupon.terms}
      </p>
    </div>
  )}
</div>
