---
/**
 * CampaignFinalCta.astro
 *
 * Bottom-of-page conversion section for campaign landing pages.
 * Split-panel: persuasive copy left, form card right, trust-card strip below.
 *
 * ponytail: uses ContactForm (the standard full form) as the campaign form.
 * Add a ContactFormSmall component if a shorter variant is needed later.
 */
import { Icon } from 'astro-icon/components';
import ContactForm from '@/components/FormComponents/ContactForm.astro';

interface Props {
  urgencyBadge?: string;
  headline: string;
  headlineAccent?: string;
  description: string;
  formHeading: string;
  formSubheading?: string;
  formHeaderVariant?: 'primary' | 'dark' | 'gradient';
  ctaText: string;
  disclaimer?: string;
  trustCards?: Array<{ icon?: string; title: string; subtitle?: string }>;
  formType?: 'quote' | 'contest';
}

const {
  urgencyBadge,
  headline,
  headlineAccent,
  description,
  formHeading,
  formSubheading,
  disclaimer,
  trustCards,
} = Astro.props;
---

<section
  id="final-cta"
  class="relative overflow-hidden"
  aria-label="Request a quote"
>
  <!-- Layered background -->
  <div class="absolute inset-0 bg-gradient-to-b from-neutral-900 via-[#0a0f1e] to-neutral-900" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_50%_at_50%_-10%,rgba(0,102,204,0.15),transparent)]" aria-hidden="true"></div>

  <!-- Top accent lines -->
  <div class="relative h-px bg-gradient-to-r from-transparent via-primary to-transparent" aria-hidden="true"></div>
  <div class="relative h-px bg-gradient-to-r from-transparent from-20% via-secondary/40 to-transparent to-80%" aria-hidden="true"></div>

  <!-- Main content -->
  <div class="section-container relative py-16 sm:py-20 lg:py-24" data-animate="fade-up">

    <!-- Two-column layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">

      <!-- Left column: copy -->
      <div class="lg:col-span-7 flex flex-col gap-6">

        {urgencyBadge && (
          <div class="inline-flex items-center gap-2 bg-red-500/15 border border-red-500/30 rounded-full px-4 py-2 w-fit">
            <Icon name="material-symbols:warning-outline" class="w-4 h-4 text-red-400 shrink-0" aria-hidden="true" />
            <span class="text-red-300 font-heading font-bold text-xs uppercase tracking-wide">{urgencyBadge}</span>
          </div>
        )}

        <h2 class="heading-display text-white text-balance">
          {headline}
          {headlineAccent && (
            <>
              <br />
              <span class="text-secondary">{headlineAccent}</span>
            </>
          )}
        </h2>

        <p class="text-white/70 text-lg leading-relaxed max-w-xl">
          {description}
        </p>

        {disclaimer && (
          <p class="text-white/40 text-sm flex items-center gap-2">
            <Icon name="material-symbols:verified-outline" class="w-4 h-4 text-secondary/60 shrink-0" aria-hidden="true" />
            {disclaimer}
          </p>
        )}
      </div>

      <!-- Right column: form card -->
      <div class="lg:col-span-5">
        <div class="bg-bg rounded-(--radius-card) shadow-xl p-6 border border-neutral-200">
          <ContactForm heading={formHeading} showHeading={true} />
        </div>

        {formSubheading && (
          <p class="text-white/50 text-xs text-center mt-3 max-w-sm mx-auto">
            {formSubheading}
          </p>
        )}
      </div>
    </div>

    <!-- Trust cards row -->
    {trustCards && trustCards.length > 0 && (
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-12 lg:mt-16">
        {trustCards.map((card) => (
          <div class="flex items-center gap-3 bg-white/[0.06] backdrop-blur-sm border border-white/10 rounded-(--radius-md) px-4 py-3">
            {card.icon && (
              <Icon name={card.icon} class="w-6 h-6 text-primary-light shrink-0" aria-hidden="true" />
            )}
            <div class="min-w-0">
              <p class="text-white/90 font-heading font-bold text-sm leading-tight">{card.title}</p>
              {card.subtitle && (
                <p class="text-white/45 text-xs leading-tight mt-0.5">{card.subtitle}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  <!-- Bottom accent line -->
  <div class="relative h-px bg-gradient-to-r from-transparent via-primary/30 to-transparent" aria-hidden="true"></div>
</section>
