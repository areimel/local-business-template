---
/**
 * ReviewsBadge.astro
 *
 * Reviews badge showing Google and Facebook ratings side by side in a
 * frosted-glass pill. Ratings/URLs come from reviews_config.yaml.
 */
import { getReviewsBadgeData } from '@/utils/reviews';
import StarRating from './StarRating.astro';
import { isFeatureEnabled } from '@/utils/features';

if (!isFeatureEnabled('reviews')) return;

const badge = getReviewsBadgeData();
---

<div class="reviews-badge inline-flex flex-col sm:flex-row items-center rounded-full px-4 py-2.5">
  <!-- Google section -->
  <div class="inline-flex items-center gap-2 px-3">
    <!-- Google "G" logo -->
    <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z" fill="#4285F4"/>
      <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
      <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A10.96 10.96 0 0 0 1 12c0 1.77.42 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
      <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
    </svg>

    <div class="flex flex-col">
      <span class="text-base font-bold text-white leading-tight">{badge.google.overallRating}</span>
      <StarRating rating={badge.google.overallRating} size="sm" />
      <a href={badge.google.reviewUrl} target="_blank" rel="noopener noreferrer" class="text-xs mt-0.5">
        Read All Reviews
      </a>
    </div>
  </div>

  <!-- Divider -->
  <div class="hidden sm:block w-px h-8 bg-white/20 mx-1"></div>

  <!-- Facebook section -->
  <div class="inline-flex items-center gap-2 px-3">
    <!-- Facebook "f" logo -->
    <svg class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="12" fill="#1877F2"/>
      <path d="M16.67 15.47l.53-3.47h-3.33V9.87c0-.95.46-1.87 1.95-1.87h1.51V5.04s-1.37-.23-2.68-.23c-2.73 0-4.52 1.66-4.52 4.66V12H7.07v3.47h3.06V24h3.77v-8.53h2.77z" fill="#fff"/>
    </svg>

    <div class="flex flex-col">
      <span class="text-base font-bold text-white leading-tight">{badge.facebook.overallRating}</span>
      <StarRating rating={badge.facebook.overallRating} size="sm" />
      <a href={badge.facebook.reviewUrl} target="_blank" rel="noopener noreferrer" class="text-xs mt-0.5">
        Read All Reviews
      </a>
    </div>
  </div>
</div>

<style>
  .reviews-badge {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .reviews-badge a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .reviews-badge a:hover {
    color: #ffffff;
  }
</style>
