---
interface Props {
  variant?: 'line' | 'dots' | 'gradient';
  spacing?: 'sm' | 'md' | 'lg';
}

const {
  variant = 'line',
  spacing = 'md',
} = Astro.props;

const spacingClasses: Record<string, string> = {
  sm: 'my-4',
  md: 'my-8',
  lg: 'my-12',
};
---

{variant === 'line' && (
  <hr class:list={['border-neutral-200', spacingClasses[spacing]]} />
)}

{variant === 'dots' && (
  <div class:list={['flex items-center justify-center gap-2 text-neutral-300', spacingClasses[spacing]]}>
    <span class="text-lg">&bull;</span>
    <span class="text-lg">&bull;</span>
    <span class="text-lg">&bull;</span>
  </div>
)}

{variant === 'gradient' && (
  <hr
    class:list={[spacingClasses[spacing], 'border-0 h-px']}
    style="background: linear-gradient(to right, transparent, var(--color-neutral-300), transparent)"
  />
)}
