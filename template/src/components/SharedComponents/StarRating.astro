---
import { Icon } from 'astro-icon/components';
import { isFeatureEnabled } from '@/utils/features';

// Root gate for all star-rating UI: reviews off hides every call site.
if (!isFeatureEnabled('reviews')) return;

interface Props {
  rating: number;
  size?: 'sm' | 'md' | 'lg';
  showCount?: boolean;
  count?: number;
}

const {
  rating,
  size = 'md',
  showCount = false,
  count,
} = Astro.props;

const sizeClasses: Record<string, string> = {
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-6 h-6',
};

const iconSize = sizeClasses[size];

const stars = Array.from({ length: 5 }, (_, i) => {
  const position = i + 1;
  if (rating >= position) return 'full';
  if (rating >= position - 0.5) return 'half';
  return 'empty';
});
---

<div class="inline-flex items-center gap-0.5">
  {stars.map((type) => (
    type === 'full' ? (
      <Icon name="material-symbols:star" class:list={[iconSize, 'text-warning']} />
    ) : type === 'half' ? (
      <Icon name="material-symbols:star-half" class:list={[iconSize, 'text-warning']} />
    ) : (
      <Icon name="material-symbols:star-outline" class:list={[iconSize, 'text-neutral-300']} />
    )
  ))}
  {showCount && count !== undefined && (
    <span class="ml-1.5 text-sm text-text-muted">({count} reviews)</span>
  )}
</div>
