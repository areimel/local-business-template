---
import { Image } from 'astro:assets';
import SectionWrapper from '@/components/SharedComponents/SectionWrapper.astro';
import Badge from '@/components/SharedComponents/Badge.astro';
import ContactForm from '@/components/FormComponents/ContactForm.astro';
import { Icon } from 'astro-icon/components';
import { getBranding } from '@/utils/data';

import techIndoor from '@/assets/images/team/tech-indoor.jpg';

const branding = getBranding();

const trustIndicators = [
  { icon: 'material-symbols:verified-outline', text: 'Licensed & Insured' },
  { icon: 'material-symbols:schedule-outline', text: 'Same-Day Availability' },
  { icon: 'material-symbols:thumb-up-outline', text: '100% Satisfaction Guarantee' },
];
---

<SectionWrapper id="contact-alt3" background="white">
  {/* Centered header */}
  <div class="text-center mb-12" data-animate="fade-up">
    <Badge text="Get in Touch" variant="primary" size="md" />
    <h2 class="heading-display mt-4">
      Request Your Free Estimate
    </h2>
    <p class="text-text-muted mt-3 max-w-xl mx-auto text-lg">
      Fill out the form below and one of our experts will get back to you within the hour.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-14 items-start">
    {/* Left column: Portrait image with accent decoration */}
    <div class="hidden lg:block lg:col-span-2 relative">
      {/* Cyan accent decoration behind the image with chamfered clip */}
      <div
        class="absolute -top-3 -left-3 w-full h-full bg-accent/20"
        style="clip-path: polygon(8% 0, 100% 0, 100% 92%, 92% 100%, 0 100%, 0 8%);"
        aria-hidden="true"
      />
      <div class="relative">
        <Image
          src={techIndoor}
          alt={`${branding.companyName} certified technician`}
          class="w-full rounded-(--radius-lg) object-cover shadow-lg"
          style="max-height: 600px;"
          widths={[400, 600]}
          sizes="(min-width: 1024px) 35vw, 100vw"
        />
      </div>

      {/* Floating trust badge */}
      <div class="absolute -bottom-4 -right-4 bg-bg rounded-(--radius-card) shadow-lg p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-success/10 flex items-center justify-center">
          <Icon name="material-symbols:check-circle" class="w-6 h-6 text-success" />
        </div>
        <div>
          <div class="font-heading font-bold text-sm">Background Checked</div>
          <div class="text-xs text-text-muted">All technicians verified</div>
        </div>
      </div>
    </div>

    {/* Right column: Contact form card */}
    <div class="lg:col-span-3">
      <div class="bg-bg rounded-(--radius-card) p-6 lg:p-8 shadow-md border border-neutral-200">
        <ContactForm heading="Send Us a Message" showHeading={true} />
      </div>

      {/* Call link */}
      <div class="text-center mt-6">
        <p class="text-text-muted text-sm mb-1">Prefer to talk to someone?</p>
        <a
          href={`tel:${branding.phoneRaw}`}
          class="inline-flex items-center gap-2 text-primary font-heading font-semibold text-lg hover:text-primary-dark transition-colors"
          aria-label={`Call us at ${branding.phone}`}
        >
          <Icon name="material-symbols:call" class="w-5 h-5" />
          Call {branding.phone}
        </a>
      </div>

      {/* Trust indicators */}
      <div class="flex flex-wrap justify-center gap-6 mt-6 border-t border-neutral-100 pt-6">
        {trustIndicators.map((item) => (
          <div class="flex items-center gap-2 text-sm text-text-muted">
            <div class="w-5 h-5 rounded-full bg-success/10 flex items-center justify-center shrink-0">
              <Icon name={item.icon} class="w-3 h-3 text-success" />
            </div>
            <span>{item.text}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</SectionWrapper>
