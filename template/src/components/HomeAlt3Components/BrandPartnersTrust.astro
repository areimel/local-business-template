---
import SectionWrapper from '@/components/SharedComponents/SectionWrapper.astro';
import BrandLogoBar from '@/components/SharedComponents/BrandLogoBar.astro';
import { Icon } from 'astro-icon/components';
import { getBranding } from '@/utils/data';

const branding = getBranding();
const currentYear = new Date().getFullYear();
const yearsInBusiness = currentYear - branding.yearEstablished;

const valueProps = [
  {
    icon: 'material-symbols:verified-outline',
    title: `${yearsInBusiness}+ Years`,
    description: `Proudly serving ${branding.serviceArea.primary} since ${branding.yearEstablished}.`,
  },
  {
    icon: 'material-symbols:family-home',
    title: 'Family Owned',
    description: 'Local roots. Personal service. Community trust.',
  },
  {
    icon: 'material-symbols:shield-outline',
    title: 'Licensed & Insured',
    description: 'Fully licensed, bonded, and insured for your peace of mind.',
  },
  {
    icon: 'material-symbols:schedule-outline',
    title: 'Same-Day Service',
    description: 'Fast response times when you need help the most.',
  },
];
---

<SectionWrapper id="trust-partners" background="alt">
  {/* Brand logos section */}
  <BrandLogoBar grayscale={false} heading="Trusted Brands We Work With" inline={true} />

  {/* Value proposition cards */}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
    {valueProps.map((prop) => (
      <div class="group relative overflow-hidden bg-bg rounded-(--radius-card) p-6 text-center shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 border border-neutral-200 hover:border-primary/25">
        <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-primary via-accent to-secondary scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left" aria-hidden="true"></div>
        <div
          class="w-14 h-14 bg-primary/10 border border-primary/20 flex items-center justify-center mx-auto mb-4"
          style="clip-path: polygon(10% 0%, 90% 0%, 100% 10%, 100% 90%, 90% 100%, 10% 100%, 0% 90%, 0% 10%);"
        >
          <Icon name={prop.icon} class="w-7 h-7 text-primary" />
        </div>
        <h3 class="font-heading font-bold text-lg mb-2">{prop.title}</h3>
        <p class="text-text-muted text-sm leading-relaxed">{prop.description}</p>
      </div>
    ))}
  </div>
</SectionWrapper>
