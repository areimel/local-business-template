---
import SectionWrapper from '@/components/SharedComponents/SectionWrapper.astro';
import PrimaryButton from '@/components/ButtonComponents/PrimaryButton.astro';
import PhoneButton from '@/components/ButtonComponents/PhoneButton.astro';
import ButtonGroup from '@/components/ButtonComponents/ButtonGroup.astro';

interface ProcessStep {
  step: number;
  title: string;
  description: string;
}

interface Props {
  steps: ProcessStep[];
  heading?: string;
  showCta?: boolean;
  freeEstimate?: boolean;
}

const { steps, heading = 'Our Process', showCta = true, freeEstimate = false } = Astro.props;
const ctaButtonText = freeEstimate ? 'Request Free Estimate' : 'Schedule Service';
const ctaSubtext = freeEstimate
  ? 'Request your free estimate today — it only takes a minute.'
  : 'Schedule your service today — it only takes a minute.';
---

<SectionWrapper background="alt">
  <h2 class="heading-display text-text text-center mb-12" data-animate="fade-up">
    {heading}
  </h2>

  <div class="relative max-w-2xl mx-auto">
    <!-- Vertical connecting line (dashed) -->
    <div
      class="absolute left-6 top-0 bottom-0 w-0.5 border-l-2 border-dashed border-primary/25"
      aria-hidden="true"
    ></div>

    {steps.map((step) => (
      <div class="flex gap-6 items-start">
        <div
          class="w-12 h-12 rounded-full text-white font-heading font-bold text-lg flex items-center justify-center shrink-0 relative z-10 shadow-md"
          style="background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));"
        >
          {step.step}
        </div>
        <div class="pb-8 lg:pb-10">
          <h3 class="text-lg font-heading font-bold text-text mb-1">{step.title}</h3>
          <p class="text-text-muted">{step.description}</p>
        </div>
      </div>
    ))}

    {/* Concluding CTA after the final step */}
    {showCta && (
      <div class="flex gap-6 items-start">
        <div
          class="w-12 h-12 rounded-full bg-secondary text-white flex items-center justify-center shrink-0 relative z-10 shadow-md"
          aria-hidden="true"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <div class="bg-bg rounded-(--radius-card) border border-neutral-200 p-5 lg:p-6 shadow-sm flex-1">
          <p class="font-heading font-bold text-text text-lg mb-1">Ready to get started?</p>
          <p class="text-text-muted text-sm mb-4">{ctaSubtext}</p>
          <ButtonGroup align="left" stack="mobile">
            <PrimaryButton text={ctaButtonText} href="/contact/" size="sm" />
            <PhoneButton size="sm" />
          </ButtonGroup>
        </div>
      </div>
    )}
  </div>
</SectionWrapper>
