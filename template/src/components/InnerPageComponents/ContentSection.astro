---
import SectionWrapper from '@/components/SharedComponents/SectionWrapper.astro';

interface Props {
  id?: string;
  maxWidth?: 'sm' | 'md' | 'lg' | 'full';
  background?: 'white' | 'alt';
}

const { id, maxWidth = 'md', background = 'white' } = Astro.props;

const maxWidthClasses: Record<string, string> = {
  sm: 'max-w-2xl',
  md: 'max-w-3xl',
  lg: 'max-w-4xl',
  full: 'max-w-none',
};
---

<SectionWrapper id={id} background={background}>
  <div class:list={['prose mx-auto', maxWidthClasses[maxWidth]]} data-animate="fade-up">
    <slot />
  </div>
</SectionWrapper>
