---
import { Icon } from 'astro-icon/components';
import SectionWrapper from '@/components/SharedComponents/SectionWrapper.astro';
import Card from '@/components/SharedComponents/Card.astro';
import Badge from '@/components/SharedComponents/Badge.astro';

interface SubService {
  title: string;
  slug: string;
  description: string;
  icon?: string;
}

interface Props {
  services: SubService[];
  category: string;
  heading?: string;
}

const { services, category, heading = 'Our Services' } = Astro.props;
---

<SectionWrapper background="white">
  <div class="text-center mb-12">
    <Badge text="Our Services" variant="primary" size="md" />
    <h2 class="heading-display text-text mt-4 mb-4">{heading}</h2>
  </div>

  <div
    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
  >
    {services.map((service) => (
      <Card variant="elevated" padding="lg" href={`/${category}/${service.slug}/`}>
        <div class="flex flex-col items-center text-center">
          <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <Icon name={service.icon || 'material-symbols:home-repair-service-outline'} class="w-7 h-7 text-primary" />
          </div>
          <h3 class="text-xl font-heading font-bold text-text mb-2">{service.title}</h3>
          <p class="text-text-muted text-sm">{service.description}</p>
        </div>
      </Card>
    ))}
  </div>
</SectionWrapper>
