---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import SectionWrapper from '@/components/SharedComponents/SectionWrapper.astro';

interface Props {
  currentSlug: string;
  nearbyLocationSlugs?: string[];
  maxItems?: number;
}

const { currentSlug, nearbyLocationSlugs = [], maxItems = 4 } = Astro.props;

const allLocations = await getCollection('locations');

// Resolve nearby from explicit slugs, or fall back to same-region siblings
let nearby = nearbyLocationSlugs.length > 0
  ? nearbyLocationSlugs
      .map(slug => allLocations.find(l => l.data.slug === slug))
      .filter(Boolean) as typeof allLocations
  : [];

if (nearby.length === 0) {
  const current = allLocations.find(l => l.data.slug === currentSlug);
  if (current) {
    nearby = allLocations
      .filter(l => l.data.region === current.data.region && l.data.slug !== currentSlug)
      .sort((a, b) => (a.data.sortOrder ?? 0) - (b.data.sortOrder ?? 0));
  }
}

nearby = nearby.slice(0, maxItems);
---

{nearby.length > 0 && (
  <SectionWrapper background="alt">
    <h2 class="heading-display text-text text-center mb-12" data-animate="fade-up">
      Nearby Service Areas
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {nearby.map((location) => (
        <a
          href={`/service-areas/${location.data.slug}/`}
          class="group block bg-bg rounded-(--radius-card) border-l-[3px] border-primary shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 p-6"
          data-animate="fade-up"
        >
          <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-4">
            <Icon name="material-symbols:location-on-outline" class="w-5 h-5 text-primary" aria-hidden="true" />
          </div>

          <h3 class="text-lg font-heading font-bold text-text mb-1 group-hover:text-primary transition-colors">
            {location.data.title}
          </h3>
          <p class="text-text-muted text-sm mb-4">{location.data.region}</p>

          <span class="inline-flex items-center gap-1 text-primary text-sm font-medium">
            View Location
            <Icon
              name="material-symbols:arrow-forward"
              class="w-4 h-4 transition-transform group-hover:translate-x-1"
              aria-hidden="true"
            />
          </span>
        </a>
      ))}
    </div>
  </SectionWrapper>
)}
