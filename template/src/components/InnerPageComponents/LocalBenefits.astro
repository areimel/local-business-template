---
import SectionWrapper from '@/components/SharedComponents/SectionWrapper.astro';
import Badge from '@/components/SharedComponents/Badge.astro';
import Card from '@/components/SharedComponents/Card.astro';
import { Icon } from 'astro-icon/components';
import { getServiceAreas, getBranding } from '@/utils/data';

const serviceAreas = getServiceAreas();
const branding = getBranding();

const localBenefits = serviceAreas.localBenefits ?? [];
---

<SectionWrapper background="white">
  <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-14 items-start">

    <!-- Intro column -->
    <div class="lg:col-span-2" data-animate="fade-up">
      <Badge text="Local Expertise" variant="secondary" size="md" />
      <h2 class="heading-display text-text mt-4 mb-6">
        Why Local Matters
      </h2>
      <p class="text-text-muted text-lg leading-relaxed mb-6">
        When your AC breaks down on the hottest day of the year, you need a team that's already nearby — not a national chain dispatching from across the state.
      </p>
      <p class="text-text-muted leading-relaxed">
        {branding.companyName} has been rooted in {branding.serviceArea.primary} since {branding.yearEstablished}. We know these neighborhoods, we understand local building codes, and we know exactly what our region's weather does to HVAC systems.
      </p>
    </div>

    <!-- Benefits grid -->
    <div class="lg:col-span-3">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {localBenefits.map((benefit) => (
          <Card variant="outlined" padding="lg">
            <div class="flex flex-col gap-4" data-animate="fade-up">
              <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center">
                <Icon name={benefit.icon} class="w-6 h-6 text-primary" />
              </div>
              <div>
                <h3 class="text-base font-heading font-bold text-text mb-2">{benefit.title}</h3>
                <p class="text-sm text-text-muted leading-relaxed">{benefit.description}</p>
              </div>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </div>
</SectionWrapper>
