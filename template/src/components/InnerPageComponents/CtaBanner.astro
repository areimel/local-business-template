---
import { getCtas } from '@/utils/data';
import PrimaryButton from '@/components/ButtonComponents/PrimaryButton.astro';
import PhoneButton from '@/components/ButtonComponents/PhoneButton.astro';
import ButtonGroup from '@/components/ButtonComponents/ButtonGroup.astro';

interface Props {
  heading?: string;
  body?: string;
  buttonText?: string;
  buttonUrl?: string;
  variant?: 'primary' | 'dark';
}

const { footerCta } = getCtas();

const {
  heading = footerCta.heading,
  body = footerCta.body,
  buttonText = footerCta.buttonText,
  buttonUrl = footerCta.buttonUrl,
  variant = 'dark',
} = Astro.props;

const bgStyle = variant === 'primary'
  ? 'background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);'
  : 'background: var(--color-neutral-900);';
---

<section
  class="relative overflow-hidden py-16 lg:py-20"
  style={bgStyle}
  aria-label="Call to action"
>
  <!-- Decorative blob -->
  <div
    class="absolute -bottom-10 -left-10 w-40 h-40 rounded-full bg-secondary/10 blur-2xl pointer-events-none"
    aria-hidden="true"
  ></div>

  <!-- Content -->
  <div class="section-container relative z-10 text-center">
    <h2
      class="text-3xl lg:text-4xl font-heading font-bold text-white mb-4"
      data-animate="fade-up"
    >
      {heading}
    </h2>

    <p
      class="text-lg text-white/90 max-w-2xl mx-auto mb-8"
      data-animate="fade-up"
    >
      {body}
    </p>

    <div data-animate="fade-up">
      <ButtonGroup align="center" stack="mobile">
        <PrimaryButton text={buttonText} href={buttonUrl} size="lg" />
        <PhoneButton size="lg" variant="secondary" />
      </ButtonGroup>
    </div>
  </div>
</section>
