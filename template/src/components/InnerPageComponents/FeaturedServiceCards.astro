---
import SectionWrapper from '@/components/SharedComponents/SectionWrapper.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  services: Array<{ title: string; slug: string; description: string }>;
  heading?: string;
}

const { services, heading } = Astro.props;
---

<SectionWrapper background="alt">
  <div class="text-center mb-12" data-animate="fade-up">
    <h2 class="heading-display text-text">
      {heading ?? 'Our Services'}
    </h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {services.map((service) => (
      <a
        href={`/${service.slug}/`}
        class="group block bg-bg rounded-(--radius-card) border border-neutral-200 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 p-6 lg:p-8"
        data-animate="fade-up"
      >
        <div class="flex flex-col items-center text-center">
          <div class="w-14 h-14 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <Icon name="material-symbols:home-repair-service-outline" class="w-7 h-7 text-primary" aria-hidden="true" />
          </div>
          <h3 class="text-xl font-heading font-bold text-text mb-2 group-hover:text-primary transition-colors">
            {service.title}
          </h3>
          <p class="text-text-muted text-sm mb-4">{service.description}</p>
          <span class="inline-flex items-center gap-1 text-primary text-sm font-medium">
            Learn More
            <Icon
              name="material-symbols:arrow-forward"
              class="w-4 h-4 transition-transform group-hover:translate-x-1"
              aria-hidden="true"
            />
          </span>
        </div>
      </a>
    ))}
  </div>
</SectionWrapper>
