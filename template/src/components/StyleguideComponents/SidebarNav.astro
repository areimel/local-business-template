---
interface Props {
  sections: { id: string; label: string }[];
}

const { sections } = Astro.props;
---

<nav aria-label="Styleguide navigation">
  <p class="font-heading font-bold text-lg mb-4 text-text">Styleguide</p>
  <ul class="space-y-1">
    {sections.map((section) => (
      <li>
        <a
          href={`#${section.id}`}
          data-sg-link={section.id}
          class="sg-nav-link block py-2 px-3 text-sm text-text-muted rounded-md transition-colors hover:bg-neutral-200 hover:text-text"
        >
          {section.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .sg-nav-link[data-active="true"] {
    background-color: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
    font-weight: 600;
  }
</style>

<script>
  function initSidebarNav() {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-sg-link]');
    if (!links.length) return;

    const sectionIds = Array.from(links).map((link) => link.dataset.sgLink!);
    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (!sections.length) return;

    function setActive(id: string) {
      links.forEach((link) => {
        link.setAttribute('data-active', link.dataset.sgLink === id ? 'true' : 'false');
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            setActive(entry.target.id);
            break;
          }
        }
      },
      { rootMargin: '-80px 0px -60% 0px', threshold: 0.1 }
    );

    sections.forEach((section) => observer.observe(section));

    // Set first section active by default
    if (sectionIds[0]) setActive(sectionIds[0]);
  }

  document.addEventListener('DOMContentLoaded', initSidebarNav);
  document.addEventListener('astro:page-load', initSidebarNav);
</script>
