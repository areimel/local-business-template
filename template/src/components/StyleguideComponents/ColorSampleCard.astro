---
interface Props {
  name: string;
  cssVar: string;
  hex: string;
  textColor?: 'light' | 'dark';
}

const {
  name,
  cssVar,
  hex,
  textColor = 'light',
} = Astro.props;

const swatchTextColor = textColor === 'dark' ? '#1a1a2e' : '#ffffff';
---

<div>
  <div
    class="h-16 rounded-t-lg flex items-end px-2 pb-2"
    style={`background-color: var(${cssVar}); color: ${swatchTextColor}`}
  >
    <span class="text-xs font-mono opacity-60 leading-none">{hex}</span>
  </div>
  <div class="p-3 border border-t-0 border-neutral-200 rounded-b-lg">
    <p class="font-heading font-semibold text-sm text-text leading-snug mb-0.5">{name}</p>
    <p class="text-xs text-text-muted font-mono leading-snug">{cssVar}</p>
  </div>
</div>
