---
interface Props {
  id: string;
  title: string;
  description?: string;
}

const { id, title, description } = Astro.props;
---

<section id={id} class="scroll-mt-20 py-12 border-b border-neutral-200 last:border-b-0">
  <h2 class="font-heading font-bold text-2xl text-text mb-2">{title}</h2>
  {description && <p class="text-text-muted mb-6">{description}</p>}
  {!description && <div class="mb-6"></div>}
  <slot />
</section>
